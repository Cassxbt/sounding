# Qwen on the Bitget S2 endpoint. Without it, the deterministic reader and template answer.
BITGET_QWEN_API_KEY=
# A read-only Bitget key, used only to read your own taker fee through Agent Hub. Optional.
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
# Signs receipts and prepared orders. Without it, nothing prepared can be verified.
SOUNDING_RECEIPT_KEY=
